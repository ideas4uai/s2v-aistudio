# Voice Studio. Cloned-voice checkpoints follow the same "models live on local disk"
# rule as Piper's, and the samples are somebody's recorded voice — personal data that
# must never end up in the repository. registry.json and audit.jsonl name real users.
voices/
.venv-clone/

# Upscaling. Same "models live on local disk" rule as Piper and the cloned voices:
# Real-ESRGAN and GFPGAN weights are ~400MB and are fetched once by setup, and the
# venv exists because basicsr's pins fight the versions the render pipeline needs.
.venv-upscale/
upscale-models/
# facexlib caches its face-detection weights here on first use.
gfpgan/

# OS files
.DS_Store
Thumbs.db

# Runtime logs
*.log
.gstack/

outputs/*.txt
outputs/**/*.json
# Composited thumbnails: derived from the render, rebuilt on demand.
outputs/thumbnails/
policy*.yaml
**/__pycache__/
*.pyc

rife/
test_veer_voice.txt

# The audit reports themselves are small and worth keeping in git. Only the
# generated merge of them is oversized: 64MB, which trips GitHub's size warning
# on every push and would land a fresh 64MB blob each time it is regenerated.
audit_output/merged_file.md

# YouTube OAuth tokens. A refresh token is a long-lived credential to publish on
# someone's channel — this must never be committed.
config/youtube-tokens.json

# Local analytics event log.
analytics/

# Local scheduled-job state.
config/schedule.json

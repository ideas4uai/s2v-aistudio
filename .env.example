# Gemini API keys — one per task to distribute quota across 4 free-tier keys
GEMINI_KEY_SCRIPT=      # Director + Scriptwriter agents
GEMINI_KEY_SCENES=      # WorldAgent + StoryboardAgent
GEMINI_KEY_VISUAL=      # Visual expansion prompts
GEMINI_KEY_IMAGE=       # Imagen 4 Fast image generation

GOOGLE_CLOUD_TTS_API_KEY=

# Supabase Storage (replaces Firebase Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Piper TTS (optional — local offline TTS, faster and free)
# Download binary: https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_windows_amd64.zip
# Download voices from: https://huggingface.co/rhasspy/piper-voices/tree/main
#   English : en/en_US/lessac/medium/en_US-lessac-medium.onnx + .onnx.json
#   Hindi   : hi/hi_IN/rohan/medium/hi_IN-rohan-medium.onnx + .onnx.json
#   Telugu  : te/te_IN/maya/medium/te_IN-maya-medium.onnx + .onnx.json
PIPER_BIN_PATH=E:\s2v-aistudio\piper\piper.exe
PIPER_VOICES_DIR=E:\s2v-aistudio\piper

# Image generation providers (tried in order: Imagen 4 Fast → Fal.ai → Together AI → Gemini → Picsum)
FAL_API_KEY=
TOGETHER_API_KEY=

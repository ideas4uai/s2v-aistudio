{
  "name": "ai-studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "cross-env NODE_ENV=development PORT=3001 tsx server.ts",
    "dev:web": "vite",
    "render": "cross-env NODE_ENV=production DISABLE_FIRESTORE=true USE_METRO_V4=true tsx server.ts",
    "render:doraemon": "cross-env NODE_ENV=production DISABLE_FIRESTORE=true USE_METRO_V4=true USE_DORAEMON=true tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "eslint . --ext ts,tsx,rules --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^1.50.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/multer": "^2.1.0",
    "@types/node-fetch": "^2.6.13",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "^12.13.0",
    "form-data": "^4.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "motion": "^11.0.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "replicate": "^1.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "together-ai": "^0.40.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/ffprobe-static": "^2.0.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.7.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^4.1.10"
  }
}
